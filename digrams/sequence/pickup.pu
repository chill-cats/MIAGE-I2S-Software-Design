@startuml pickup
skinparam sequenceMessageAlign center
actor Customer as cust
actor Employee as emp

participant ":System" as sys

activate emp
activate cust
cust -> emp: request for car 
emp -> sys: Lookup reservation(customer details)
activate sys
sys --> emp: reservation details
emp -> sys: query available car(car type)
sys --> emp: list of car


hide footbox
@enduml