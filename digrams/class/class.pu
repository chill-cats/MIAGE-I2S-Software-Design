@startuml class

' !theme plain

class Customer {
    - email : String
    - firstName : String
    - lastName : String

    + getReservation() : Reservation
    + getDriverLicense() : DriverLicense
}

class Address {
    - street : String
    - city : String
    - country : String
    - zipCode : String
}

class DriverLicense {
    - scan : URL
}

' class Agency {
'     - name : String
' }

class CarType {
    - description : String
    - name : String
    - typicalPassengerCount : Integer
    - typicalWindowCount : Integer
    - gearBox: GearboxType
    - typicalCar : String

    + getDetails() :
    + getCars() : Car[]
}

class Car {
    - brand : String
    - color : String
    - licensePlateNumber : String
}

abstract class Reservation {
    - pickupDateTime : DateTime
    - returnDateTime : DateTime
    - paymentOption : PaymentOption
    - status : ReservationStatus
    - price : Decimal

    + {abstract} cancel() : void
}

class PrepaidReservation {
    + calculateCancelationFee()
    + cancel() : void
}

class PaylaterReservation {
    + cancel() : void
}


class Insurance {
    - name : String
    - pricePerDay : Decimal
}

class ExtraOption {
    - name : String
    - price : Decimal
    - picture: URL
}

class Payment {
    - amount : Decimal
    - dateTime: DateTime [0..1]
    - purpose : PaymentPurpose
}

' class Prepay {
'     - payByCreditCard()
' }

' class PayLater {
' }

' Payment <|-- Prepay
' Payment <|-- PayLater

class Rental {
    - pickupDateTime : DateTime
    - returnDateTime : DateTime [0..1]
    - returnMileage : Integer [0..1]
}

class VehicleInspection {
    - inspectionType : InspectionType
    - condition : String
    - dateTime : DateTime
    - customerSignature : Binary [0..1]
}

class Incident {
    - incidentType : IncidentType
    - location : String
    - occurredAt : DateTime
    - circumstances : String
}

class IncidentPhoto {
    - photo : URI
}

enum ReservationStatus {
    CONFIRMED
    CANCELLED
    COMPLETED
}

enum PaymentOption {
    PREPAY
    PAY_AT_PICKUP
}

enum PaymentPurpose {
    RENTAL_CHARGE
    CANCELLATION_FEE
}

enum InspectionType {
    PICKUP
    RETURN
}

enum IncidentType {
  ACCIDENT
  BREAKDOWN
}

enum GearboxType {
    AUTOMATIC
    MANUAL
}

Customer "0..*" -- "1" Address : lives at
Customer "1" -- "0..*" Reservation : makes
Customer "1" -- "0..*" DriverLicense : possesses

Reservation "0..*" -- "1" CarType : selects
Reservation "1" -- "0..1" Rental : results in
Reservation "0..*" -- "1" Address : pickup and return location
Reservation "0..*" -- "0..*" Insurance : coverage
Reservation "0..*" -- "0..*" ExtraOption : selects
Reservation "1" -- "0..*" Payment : payments

Rental "1" -- "0..2" VehicleInspection : inspections
Rental "1" *-- "0..*" Incident : incidents

Incident "1" *-- "1..*" IncidentPhoto : has

Car "1" -- "0..*" Rental : allocated vehicle
CarType "1" -- "0..*\n" Car : classifies \n

Reservation <|-- PaylaterReservation
Reservation <|-- PrepaidReservation


@enduml